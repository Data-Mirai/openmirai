# OpenMirai en contenedores — copiar a `.env` y ajustar.
#   cp .env.example .env
#
# `.env` está en .gitignore: las claves reales nunca se commitean.

# --- API -------------------------------------------------------------------
# Clave del header X-API-Key. OBLIGATORIA con el compose: el contenedor bindea
# 0.0.0.0 y desde 0.7.0 el motor se niega a arrancar fuera de loopback sin
# clave. Cambiala: este valor es un placeholder público del repo.
MIRAI_API_KEY=openmirai-dev

# Puerto publicado en el host. Adentro el motor siempre escucha en 3000.
# 4321 es el puerto que el resto del ecosistema Mirai espera del motor.
MIRAI_PUBLIC_PORT=4321

# --- Base de datos ---------------------------------------------------------
# Archivo SQLite único: guarda los runs (0.7.0) y el registro de agentes. Vive
# en el volumen, así las ejecuciones y los agentes —incluidos los live que
# estaban ciclando— sobreviven al reinicio del contenedor.
# Sin esta variable el default es ~/.openmirai/engine.db, que muere con el
# contenedor.
MIRAI_DB_PATH=/data/openmirai.db

# --- LLM -------------------------------------------------------------------
# mock | ollama | claude | openai | gemini | groq | nvidia | openrouter
#
# `mock` devuelve respuestas deterministas sin red ni API key: es el modo con
# el que corre la suite e2e y el que conviene para CI.
MIRAI_LLM_PROVIDER=mock

# Modelo por defecto. Dejar comentado para que cada proveedor use el suyo:
# definirlo vacío haría que el motor lo tome como un modelo llamado "".
# MIRAI_LLM_MODEL=gemini-2.5-flash

# --- Claves de proveedor ---------------------------------------------------
# Solo hacen falta las del proveedor elegido. Descomentar lo que se use.
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=

# --- Ollama local (perfil llm-local) ---------------------------------------
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_PUBLIC_PORT=11434
