# Contexto de build de Docker — mantenerlo chico acelera cada `docker build`.
# El Dockerfile solo necesita: Cargo.toml, Cargo.lock, engine/src, cli/src y docker/.

.git
.github
target
**/target
releases

# Docs, SDKs y superficies que no entran en la imagen del motor.
docs
sdks
examples
test
showcase
visualizer
plan
tools
*.md
!docker/README.md

# Entorno y secretos — nunca deben viajar al contexto de build.
.env
.env.*
!.env.example

# Artefactos locales
*.db
*.sqlite
*.sqlite3
*.log
node_modules
__pycache__
.venv
venv

