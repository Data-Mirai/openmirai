# OpenMirai en contenedores — copiar a `.env` y ajustar.
#   cp .env.example .env
#
# `.env` está en .gitignore: las claves reales nunca se commitean.

# --- API -------------------------------------------------------------------
# Clave del header X-API-Key. Va vacía a propósito: `docker compose up` corta
# con un error hasta que pongas una. No hay valor por defecto porque cualquier
# clave de ejemplo publicada acá sería tan buena como no tener ninguna, y la
# API permite ejecutar comandos (/agents/*/execute, /orchestrator/*).
#
# Generala así:   openssl rand -hex 32
MIRAI_API_KEY=

# Interfaz del host donde se publica el motor. Por defecto solo loopback:
# nadie fuera de esta máquina lo alcanza. Para exponerlo a la red local
# —por ejemplo para que AgentMirai se conecte desde otra máquina— poné
# 0.0.0.0, y asegurate de que MIRAI_API_KEY sea una clave real.
MIRAI_BIND_ADDR=127.0.0.1

# Puerto publicado en el host. Adentro el motor siempre escucha en 3000.
# 4321 es el puerto que el resto del ecosistema Mirai espera del motor.
MIRAI_PUBLIC_PORT=4321

# --- Base de datos ---------------------------------------------------------
# Archivo SQLite único: runs, registro de agentes y su memoria. La ruta es la
# que fija docs/infra/CONTAINER-RUNTIME-CONTRACT.md. Vive en el volumen, así
# todo eso sobrevive al reinicio del contenedor.
# Sin esta variable el default es ~/.openmirai/engine.db, que muere con el
# contenedor.
MIRAI_DB_PATH=/data/openmirai/engine.db

# --- LLM -------------------------------------------------------------------
# mock | ollama | claude | openai | gemini | groq | nvidia | openrouter
#
# `mock` devuelve respuestas deterministas sin red ni API key: es el modo con
# el que corre la suite e2e y el que conviene para CI.
MIRAI_LLM_PROVIDER=mock

# Modelo por defecto. Dejar comentado para que cada proveedor use el suyo:
# definirlo vacío haría que el motor lo tome como un modelo llamado "".
# MIRAI_LLM_MODEL=gemini-2.5-flash

# --- Claves de proveedor ---------------------------------------------------
# Solo hacen falta las del proveedor elegido. Descomentar lo que se use.
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=
# OPENAI_API_KEY=
# GROQ_API_KEY=
# NVIDIA_API_KEY=
# OPENROUTER_API_KEY=

# --- Ollama local (perfil llm-local) ---------------------------------------
# El motor lo alcanza por nombre de servicio dentro de la red de compose; el
# contenedor de Ollama no publica ningún puerto en el host (no tiene auth).
# OLLAMA_BASE_URL=http://ollama:11434
